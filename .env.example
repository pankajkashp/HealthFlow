# HealthFlow — Environment Variable Reference
#
# This file documents environment variable names for local development.
# Copy this file to .env (which is git-ignored) for local overrides.
# No secrets, real credentials, or production configurations belong here — set your own
# ANTHROPIC_API_KEY (or AWS credentials for Bedrock) in your local .env only, never commit it.

# --- API Application ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/healthflow_dev

# --- Frontend Application ---
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Database (Docker Compose local dev; migrated + seeded automatically on container start) ---
POSTGRES_DB=healthflow_dev
POSTGRES_USER=healthflow
POSTGRES_PASSWORD=changeme_local_only

# --- Agent LLM Provider (Phase 6) ---
# "scripted" (default): deterministic offline path, no credentials needed, used by the test suite.
# "anthropic": real LLM tool-calling via the Anthropic API. Get a key at console.anthropic.com.
# "bedrock": real LLM tool-calling via AWS Bedrock — the originally locked §17 tech stack; needs
#            AWS credentials with Bedrock model access for BEDROCK_MODEL_ID already granted.
LLM_PROVIDER=scripted
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-4-5-20250929
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AGENT_MAX_ITERATIONS=15
AGENT_TEMPERATURE=0.0
AGENT_MAX_TOKENS=4096
